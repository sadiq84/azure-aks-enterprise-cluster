environment         = "prod"
location            = "eastus"
resource_group_name = "rg-aks-enterprise-prod"
cluster_name        = "aks-core-enterprise-prod"
kubernetes_version  = "1.28.5"
vnet_address_space  = ["10.200.0.0/16"]
aks_subnet_prefix   = ["10.200.4.0/22"]
